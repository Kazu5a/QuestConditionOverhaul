<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.1</Version>
    <ModFolderName>kazusa-QuestConditionOverhaul</ModFolderName>
    <ReleaseOutputDir>Build\SPT\user\mods\kazusa-QuestConditionOverhaul\</ReleaseOutputDir>
    <ReleaseZipPath>Release\$(ModFolderName)-$(Version).zip</ReleaseZipPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.0.0" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.0" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.jsonc">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="License">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CleanUnwantedFiles" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <UnwantedFiles Include="$(OutputPath)*.pdb;$(OutputPath)*.deps.json;$(OutputPath)*.runtimeconfig.*" />
    </ItemGroup>
    <Delete Files="@(UnwantedFiles)" />
  </Target>

  <Target Name="CopyBuildOutput" AfterTargets="CleanUnwantedFiles" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(ReleaseOutputDir)" />
    <ItemGroup>
      <RemainingFiles Include="$(OutputPath)**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(RemainingFiles)"
      DestinationFiles="@(RemainingFiles->'$(ReleaseOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
    />
    <Copy
      SourceFiles="License"
      DestinationFiles="$(ReleaseOutputDir)LICENSE"
    />
  </Target>

  <Target Name="CreateReleaseZip" AfterTargets="CopyBuildOutput" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(ReleaseZipPath)'))" />
    <Delete Files="$(ReleaseZipPath)" TreatErrorsAsWarnings="true" />
    <ZipDirectory
      SourceDirectory="Build"
      DestinationFile="$(ReleaseZipPath)"
      Overwrite="true"
    />
  </Target>
</Project>
