{
  // Enable or disable the mod entirely
  "enabled": true,

  // Process all loaded quests (vanilla + modded). If false, only targetTraderIds will be processed.
  "processAllQuests": true,

  // List of trader IDs to process if processAllQuests is false
  "targetTraderIds": [],

  // List of quest IDs to exclude from overhaul
  "excludedQuestIds": [],

  // List of trader IDs to exclude from overhaul
  "excludedTraderIds": [],

  // Force quest locations to be "Any" (any map). If true, quests can be completed on any map. If false, quests are restricted to their original map (e.g. Customs, Woods), but specific sub-area restrictions (e.g. Gas Station, Dorms) are always removed.
  "setLocationToAny": true,

  // The seed value for deterministic generation. Change this to roll a completely new set of quests.
  "seed": "quest-condition-overhaul-v1",

  // Relative weights for generating quest conditions. They will be normalized automatically.
  "weights": {
    "kills": 40,
    "dogtags": 40,
    "money": 20
  },

  // Range of targets required for kill quests
  "kills": {
    "pmcChance": 70,            // Chance (0-100) of rolling a PMC target instead of a SCAV target
    "usecChance": 50,           // Chance (0-100) of rolling a USEC target instead of a BEAR target when distinguishFactions is true
    "minCount": 10,
    "maxCount": 50,
    // If true, distinguishes between USEC and BEAR PMCs. If false, kills are merged into generic "PMC" targets.
    "distinguishFactions": true
  },

  // Dogtag quest options
  "dogtags": {
    "usecChance": 50,          // Chance (0-100) of USEC dogtags being rolled instead of BEAR dogtags
    "minCount": 5,             // Minimum dogtags required
    "maxCount": 20,            // Maximum dogtags required
    "onlyFoundInRaid": true,   // If true, only found-in-raid dogtags are accepted
    // If true, distinguishes between USEC and BEAR dogtags. If false, allows handing over any PMC dogtags.
    "distinguishFactions": true,
    "usecTemplateIds": [       // List of acceptable USEC dogtag item template IDs. If empty, falls back to defaults.
      // --- Vanilla USEC Dogtags ---
      "59f32c3b86f77472a31742f0", // USEC Dogtag (Lv 1-14)
      "6662ea05f6259762c56f3189", // USEC Dogtag (Lv 15-29)
      "6662e9f37fa79a6d83730fa0", // USEC Dogtag (Lv 30-49)
      "6764207f2fa5e32733055c4a", // USEC Dogtag (Lv 50-59)
      "6764202ae307804338014c1a", // USEC Dogtag (Lv 60-79)
      "68418091b5b0c9e4c60f0e7a", // USEC Dogtag (Lv 80+)

      // --- WTT-ContentBackport Custom USEC Dogtags ---
      "68df99c05d4e135b130392cc", // WTT USEC Story 4: For humanity
      "68df99a614ca2428b2017cd8", // WTT USEC Story 2: In the darkness
      "68df99b2f716906506098308", // WTT USEC Story 3: Didn't escape from yourself
      "68df99975d4e135b130392ca", // WTT USEC Story 1: And survived
      "68f15dbab2b53abd200b9378", // WTT USEC Birth of the legend
      "68f0f64f183146ea530330aa", // WTT USEC Special status
      "68fb4157b280c103230e3b3c", // WTT USEC Notches
      "68f0f662859ebec8d501b76a", // WTT USEC Thumb drive variant
      "68fb4143a854bc7ae80fad3e", // WTT USEC True believers
      "68f15e53103c5d9d4f022c78"  // WTT USEC Decisive moment
    ],
    "bearTemplateIds": [       // List of acceptable BEAR dogtag item template IDs. If empty, falls back to defaults.
      // --- Vanilla BEAR Dogtags ---
      "59f32bb586f774757e1e8442", // BEAR Dogtag (Lv 1-14)
      "6662e9cda7e0b43baa3d5f76", // BEAR Dogtag (Lv 15-29)
      "6662e9aca7e0b43baa3d5f74", // BEAR Dogtag (Lv 30-49)
      "684181208d035f60230f63f9", // BEAR Dogtag (Lv 50-59)
      "684180bc51bf8645f7067bc8", // BEAR Dogtag (Lv 60-79)
      "675dcb0545b1a2d108011b2b", // BEAR Dogtag (Lv 80-99)
      "675dc9d37ae1a8792107ca96", // BEAR Dogtag (Lv 100+)

      // --- WTT-ContentBackport Custom BEAR Dogtags ---
      "68df9927a38a5e37d80df6c9", // WTT BEAR Story 4: For humanity
      "68df991142e96f583d042b8a", // WTT BEAR Story 2: In the darkness
      "68df991dbeba86572e097ceb", // WTT BEAR Story 3: Didn't escape from yourself
      "68df9908972cf1e1ec07256a", // WTT BEAR Story 1: And survived
      "68f0f63c645c14a02104142a", // WTT BEAR Thumb drive variant
      "68fb412b0760c7891606613e", // WTT BEAR Notches
      "68f15cf222c8979ee308f495", // WTT BEAR Birth of the legend
      "68f0f60a121d878a2303eedb", // WTT BEAR Special status
      "68fb41120760c7891606613c", // WTT BEAR True believers
      "68f15e26f1aa7e100a0ca208", // WTT BEAR Decisive moment
      "68f153aa7da590b6df0515da"  // WTT BEAR Most persistent
    ]
  },

  // Range of money required for currency handover quests
  "money": {
    "roublesChance": 60,       // Chance (0-100) of rolling Roubles
    "eurosChance": 20,         // Chance (0-100) of rolling Euros
    "dollarsChance": 20,       // Chance (0-100) of rolling Dollars
    "roublesMin": 500000,
    "roublesMax": 5000000,
    "roublesStep": 10000,
    "eurosMin": 2000,
    "eurosMax": 20000,
    "eurosStep": 100,
    "dollarsMin": 2000,
    "dollarsMax": 20000,
    "dollarsStep": 100
  },

  // Multilingual formatting templates for quest descriptions
  "locales": {
    "ch": {
      "kill": "在任意地图击杀 {count} 名 {target}",
      "dogtag": "在战局中上交 {count} 个 {faction} 身份牌",
